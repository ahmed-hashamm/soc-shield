# ─────────────────────────────────────────────
# SUPABASE
# ─────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─────────────────────────────────────────────
# UPSTASH REDIS (Rate Limiting)
# ─────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# ─────────────────────────────────────────────
# EXTENSION JWT (RS256)
# Generate with: node -e "const { generateKeyPair } = require('jose'); (async () => { const { publicKey, privateKey } = await generateKeyPair('RS256'); console.log('PRIVATE:', await require('jose').exportPKCS8(privateKey)); console.log('PUBLIC:', await require('jose').exportSPKI(publicKey)); })()"
# ─────────────────────────────────────────────
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour-private-key\n-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nyour-public-key\n-----END PUBLIC KEY-----"

# ─────────────────────────────────────────────
# CRON SECRET (for Vercel Cron jobs)
# Generate with: openssl rand -hex 32
# ─────────────────────────────────────────────
CRON_SECRET=your-cron-secret

# ─────────────────────────────────────────────
# ABUSEIPDB (Phase 2)
# ─────────────────────────────────────────────
ABUSEIPDB_API_KEY=your-abuseipdb-key
